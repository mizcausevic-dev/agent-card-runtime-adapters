{
  "name": "agent-card-runtime-adapters",
  "version": "0.1.0",
  "description": "Convert a Kinetic Gain Agent Card into runtime-specific agent configs — OpenAI Assistants, Anthropic system-prompt bundle, Vercel AI SDK, and a markdown briefing.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/agent-card-runtime-adapters"
  },
  "keywords": [
    "agent-card",
    "agents",
    "ai-governance",
    "openai-assistants",
    "anthropic",
    "vercel-ai-sdk",
    "adapter",
    "kinetic-gain"
  ],
  "bin": {
    "agent-card-adapt": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts fixtures/customer-support-agent.json --target markdown",
    "adapt": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^10.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
